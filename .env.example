# Default: OpenAI.
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# LLM_BASE_URL=

# Alternative: Gemini via its OpenAI-compatible endpoint (tested working
# 2026-08-25 with chat, json_object structured output, and embeddings).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

VISUAL_ANOMALY_THRESHOLD=0.55
AUDIO_ANOMALY_THRESHOLD=0.55
